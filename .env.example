# Copie para .env e preencha. Nunca versione o .env real.

# Obrigatório em produção. Use uma chave longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=

# Obrigatório em produção (usada apenas ao criar o primeiro usuário admin)
ADMIN_PASSWORD=

# Opcional. Email do admin inicial (padrão: admin@tiasam.local)
ADMIN_EMAIL=

# Porta do servidor (padrão: 4000)
# PORT=4000

# Origens permitidas para CORS (separadas por vírgula).
# Em dev o proxy do Vite já cobre; em produção defina a URL do site.
# CORS_ORIGINS=https://meusite.com.br

# Defina como 1 se estiver atrás de um proxy reverso (nginx, cloudflare, etc.)
# TRUST_PROXY=0

# Defina como production em produção (ativa cookie secure e exige segredos)
# NODE_ENV=production
