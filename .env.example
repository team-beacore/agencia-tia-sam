# Copie para .env e preencha. Nunca versione o .env real.

# ============================================================================
# OBRIGATÓRIAS EM PRODUÇÃO
# ============================================================================

# Chave de assinatura dos tokens JWT.
# Gere uma longa e aleatória:
#   openssl rand -hex 32
# Em produção o servidor RECUSA iniciar sem ela.
JWT_SECRET=

# Senha do usuário admin inicial. Só é usada ao criar o PRIMEIRO admin
# (banco vazio). Em produção o servidor RECUSA iniciar sem ela se o banco
# estiver vazio. Altere depois pelo painel se desejado.
ADMIN_PASSWORD=

# Origens permitidas para CORS (separadas por vírgula).
# Em produção defina a URL do seu site:
CORS_ORIGINS=https://seu-dominio.com.br

# ============================================================================
# RECOMENDADAS EM PRODUÇÃO
# ============================================================================

# Define o ambiente como produção (cookie Secure + exige segredos acima).
NODE_ENV=production

# Porta em que o Node escuta. O Nginx encaminha para esta porta.
PORT=4000

# Configure como 1 quando estiver atrás de um proxy reverso (Nginx, Cloudflare).
# Necessário para o rate limit funcionar com o IP real do visitante.
TRUST_PROXY=1

# ============================================================================
# OPCIONAIS
# ============================================================================

# Email do admin inicial (padrão: admin@tiasam.local)
#ADMIN_EMAIL=admin@seu-dominio.com.br
