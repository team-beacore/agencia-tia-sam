# Copie para .env e preencha. Nunca versione o .env real.
# Em produção os valores acima NÃO têm defaults seguros: o servidor recusa iniciar sem eles.

# ============================================================================
# OBRIGATÓRIAS EM PRODUÇÃO
# ============================================================================

# Chave de assinatura dos tokens JWT. Sem valor hardcoded no código.
# Gere uma longa e aleatória:
#   openssl rand -hex 32
# Em produção o servidor ABORTA o startup sem ela.
# Fora de produção, se ausente, é gerada uma chave aleatória EFÊMERA
# (todas as sessões caem a cada restart) — apenas para desenvolvimento.
JWT_SECRET=

# Senha do usuário admin inicial. Não existe senha padrão no código.
# Em produção é obrigatória quando o banco está vazio (bootstrap do 1º admin);
# após o primeiro boot você pode removê-la do .env.
# Em desenvolvimento, se ausente, uma senha aleatória é gerada e exibida no log.
ADMIN_PASSWORD=

# Email do usuário admin inicial (necessário junto com ADMIN_PASSWORD no 1º boot).
ADMIN_EMAIL=admin@SEU-DOMINIO.com.br

# Origens permitidas para CORS (separadas por vírgula). Em produção, a URL real do site.
CORS_ORIGINS=https://seu-dominio.com.br

# Diretório de dados persistentes (banco SQLite + uploads). Fonte única: server/db.js.
# EM PRODUÇÃO É OBRIGATÓRIO: com NODE_ENV=production e DATA_DIR ausente o servidor
# ABORTA o startup (não existe fallback ./data em produção).
# Em desenvolvimento é opcional: sem ele os dados ficam em ./data (relativo ao repo).
# A aplicação cria o diretório (e uploads/) automaticamente se não existir.
DATA_DIR=/var/www/agencia-tia-sam/data

# ============================================================================
# RECOMENDADAS EM PRODUÇÃO
# ============================================================================

# Define o ambiente como produção (cookie Secure + exigência das variáveis acima).
NODE_ENV=production

# Porta em que o Node escuta. O Nginx encaminha para esta porta.
PORT=4000

# Configure como 1 quando estiver atrás de um proxy reverso (Nginx, Cloudflare).
# Necessário para o rate limit funcionar com o IP real do visitante.
TRUST_PROXY=1

# ============================================================================
# BACKUP (scripts/backup.sh) — opcionais
# ============================================================================

# Destino dos backups locais (padrão: <repo>/backups). Idealmente outro disco:
# BACKUP_DIR=/mnt/backup/tia-sam

# Dias de retenção (padrão 14):
# BACKUP_RETENTION_DAYS=14

# Cópia EXTERNA (fortemente recomendada — backup local no mesmo disco NÃO basta):
# Sem credenciais no repositório; configure rclone (`rclone config`) ou chaves SSH.
# Exemplos aceitos por scripts/backup.sh:
# BACKUP_REMOTE=rclone-tiasam:tia-sam-backups
# BACKUP_REMOTE=backup@outra-maquina:/backups/tia-sam
# BACKUP_REMOTE=/mnt/backup-externo/tia-sam
